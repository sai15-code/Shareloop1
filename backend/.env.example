# Locally defaults to 5000. Render supplies PORT at runtime.
PORT=5000
NODE_ENV=development
# Use your Atlas connection string in the Render environment, not in this file.
MONGODB_URI=mongodb://127.0.0.1:27017/shareloop
# Replace locally; production requires at least 32 random bytes.
JWT_SECRET=replace_with_a_long_random_secret
# Exact frontend origin(s); separate multiple origins with commas.
CLIENT_URL=http://localhost:3000
